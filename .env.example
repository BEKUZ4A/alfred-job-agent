# Google AI Studio API kaliti
GEMINI_API_KEY=your_gemini_api_key_here

# Telegram Bot Token (@BotFather dan olinadi)
# Masalan: 7123456789:AAHq_ABCDEF...
TELEGRAM_BOT_TOKEN=

# Sizning Telegram raqamingiz/chat ID (@userinfobot dan olinadi)
# Masalan: 123456789
TELEGRAM_CHAT_ID=

# CallMeBot orqali qo'ng'iroq olish uchun Telegram username (ixtiyoriy)
# Masalan: @behruz_dev
CALLMEBOT_USERNAME=

# Minimal moslik bali (0 dan 100 gacha, tavsiya etiladi: 65)
MIN_MATCH_SCORE=65

# TTS Ovoz Sozlamalari (Ixtiyoriy)
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Aoede  # Aoede (yoqimli) yoki Charon (jiddiy erkak)
EDGE_TTS_VOICE=uz-UZ-SardorNeural
EDGE_TTS_RATE=+8%
EDGE_TTS_PITCH=-2Hz

# Server porti (Render avtomatik o'rnatadi, mahalliy sinov uchun 8000)
PORT=8000
